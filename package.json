{
  "name": "valley-loader",
  "productName": "Valley Loader",
  "version": "0.1.0",
  "description": "Install Nexus Mods Stardew Valley collections on macOS",
  "keywords": [
    "stardew-valley",
    "nexus-mods",
    "smapi",
    "mod-manager",
    "collections",
    "macos",
    "electron"
  ],
  "homepage": "https://github.com/pratiksavla/valley-loader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratiksavla/valley-loader.git"
  },
  "bugs": {
    "url": "https://github.com/pratiksavla/valley-loader/issues"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Pratik Savla",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "live-check": "node --env-file=.env --experimental-strip-types scripts/live-check.ts",
    "package": "npm run build && electron-builder --mac --arm64 --config electron-builder.yml"
  },
  "dependencies": {
    "7zip-bin": "5.2.0",
    "node-unrar-js": "2.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "engines": {
    "node": ">=22"
  }
}
